{
  "expo": {
    "name": "AG Remote",
    "slug": "ag-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "scheme": "ag-remote",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AG Remote to access your camera to scan bridge pairing QR codes."
        }
      ],
      "expo-font"
    ]
  }
}
