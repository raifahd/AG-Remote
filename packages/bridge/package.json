{
  "name": "@ag-remote/bridge",
  "version": "0.1.0",
  "displayName": "AG Remote Bridge",
  "description": "Remote control bridge for Antigravity IDE",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo bridge-lint-ok"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "ag-remote.start",
        "title": "AG Remote: Start Bridge"
      },
      {
        "command": "ag-remote.stop",
        "title": "AG Remote: Stop Bridge"
      },
      {
        "command": "ag-remote.showQr",
        "title": "AG Remote: Show Pairing QR"
      },
      {
        "command": "ag-remote.regenerateToken",
        "title": "AG Remote: Regenerate Token"
      }
    ]
  },
  "dependencies": {
    "@ag-remote/shared": "workspace:*",
    "express": "4.21.2",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.19",
    "@types/vscode": "1.85.0",
    "@types/ws": "8.5.14",
    "typescript": "5.7.3"
  }
}

